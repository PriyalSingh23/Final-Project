options:
  parameters:
    author: yasht
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: CGAN RX lab scaffold; requires external frame/carrier synchronization
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx_lpi_cgan
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LPI-CGAN Receiver
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: 'UNSET: enter an authorized frequency supported by your exact USRP before running'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 12]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: ''
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 12]
    rotation: 0
    state: enabled
- name: frame_size
  id: variable
  parameters:
    comment: ''
    value: '512'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 12]
    rotation: 0
    state: enabled
- name: uhd_usrp_source_0
  id: uhd_usrp_source
  parameters:
    affinity: ''
    alias: ''
    ant0: '"RX2"'
    bw0: '0'
    center_freq0: center_freq
    clock_rate: 30.72e6
    clock_source0: ''
    comment: ''
    dc_offs0: 0+0j
    dc_offs_enb0: default
    dev_addr: '""'
    dev_args: ''
    gain0: rx_gain
    gain_type0: default
    iq_imbal0: 0+0j
    iq_imbal_enb0: default
    lo_export0: 'False'
    lo_source0: internal
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    num_mboards: '1'
    otw: ''
    rx_agc0: Default
    samp_rate: samp_rate
    sd_spec0: ''
    show_lo_controls: 'False'
    start_time: '-1.0'
    stream_args: ''
    stream_chans: '[]'
    sync: none
    time_source0: ''
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 304]
    rotation: 0
    state: enabled
- name: blocks_file_sink_raw
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Raw capture for offline inspection; no synchronization or validated OTA assessment
    file: rx_raw.fc32
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 480]
    rotation: 0
    state: enabled
- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: Accumulate 512 covert samples into one vector
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '512'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 304]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source: "import numpy as np\nfrom gnuradio import gr\n\nclass cgan_decoder_block(gr.sync_block):\n    def __init__(self, model_path='decoder_lpi.pt', remove_dc=False, normalize_rms=False):\n        gr.sync_block.__init__(self, name='CGAN_LPI_Decoder', in_sig=[(np.complex64, 512)], out_sig=[(np.complex64, 256)])\n        import torch\n        self.torch = torch\n        self.device = 'cuda' if torch.cuda.is_available() else 'cpu'\n        self.model = torch.jit.load(model_path, map_location=self.device).eval()\n        self.remove_dc = bool(remove_dc)\n        self.normalize_rms = bool(normalize_rms)\n        print(f'[CGAN Dec] Loaded on {self.device}; remove_dc={self.remove_dc}; normalize_rms={self.normalize_rms}')\n\n    def work(self, input_items, output_items):\n        frames = input_items[0]\n        out = output_items[0]\n        if len(frames) == 0:\n            return 0\n        iq = np.stack((frames.real, frames.imag), axis=1).astype(np.float32, copy=False)\n        if self.remove_dc:\n            iq = iq - iq.mean(axis=2, keepdims=True)\n        if self.normalize_rms:\n            rms = np.sqrt(np.mean(iq * iq, axis=(1, 2), keepdims=True) + 1e-8)\n            iq = iq / rms\n        tensor = self.torch.from_numpy(np.ascontiguousarray(iq)).to(self.device)\n        with self.torch.inference_mode():\n            probabilities = self.model(tensor).cpu().numpy()\n        out[:] = np.where(probabilities > 0.5, 1.0, -1.0).astype(np.complex64)\n        return len(frames)\n"
    affinity: ''
    alias: ''
    comment: Decoder only; no preamble/frame/CFO/phase synchronization is implemented
    maxoutbuf: '0'
    minoutbuf: '0'
    model_path: decoder_lpi.pt
    remove_dc: 'False'
    normalize_rms: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 304]
    rotation: 0
    state: enabled
- name: blocks_vector_to_stream_0
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '256'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [832, 304]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Decoder output; graph assumes exact 512-sample frame alignment
    file: recovered_symbols.fc32
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1056, 304]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'False'
    gui_hint: ''
    label1: RX I
    label10: Signal 10
    label2: RX Q
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '""'
    nconnections: '1'
    size: '1024'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 560]
    rotation: 0
    state: enabled

connections:
- [uhd_usrp_source_0, '0', blocks_file_sink_raw, '0']
- [uhd_usrp_source_0, '0', blocks_stream_to_vector_0, '0']
- [uhd_usrp_source_0, '0', qtgui_time_sink_x_0, '0']
- [blocks_stream_to_vector_0, '0', epy_block_0, '0']
- [epy_block_0, '0', blocks_vector_to_stream_0, '0']
- [blocks_vector_to_stream_0, '0', blocks_file_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
