  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Ground-truth bit stream (MSB-first unpacked bytes) for offline BER
    file: C:\\Users\\gspra\\OneDrive\\Desktop\\LPI_CGAN\\tx_bits.uint8
    type: byte
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
