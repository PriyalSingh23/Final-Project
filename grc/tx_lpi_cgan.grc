    bus_structure: null
    coordinate: [304, 480]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: byte 0 -> -1, byte 1 -> +1 (matches decoder sigmoid target)
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: (-1,1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 304]
    rotation: 0
    state: enabled
- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: Accumulate 256 BPSK symbols into one message vector
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '256'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 304]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import os, numpy as np\nfrom gnuradio import gr\n\nclass cgan_generator_block(gr.sync_block):\n    def __init__(self, model_path='generator_lpi.pt', gain_factor=0.35):\n        gr.sync_block.__init__(self, name='CGAN_LPI_Generator', in_sig=[(np.complex64, 256)], out_sig=[(np.complex64, 512)])\n        import torch\n        self.torch = torch\n        self.device = 'cpu'\n        if not os.path.exists(model_path):\n            for cand in ['generator_lpi.pt', 'C:/Users/gspra/OneDrive/Desktop/LPI_CGAN/generator_lpi.pt', '../generator_lpi.pt']:\n                if os.path.exists(cand):\n                    model_path = cand\n                    break\n        self.model = torch.jit.load(model_path, map_location=self.device)\n        self.model.eval()\n        self.gain = gain_factor\n        self.gpu_noise = torch.zeros(1, 64, dtype=torch.float32, device=self.device)\n        self.b_tensor = torch.zeros(1, 256, dtype=torch.float32, device=self.device)\n        print(f'[CGAN Gen] Loaded from {model_path} on {self.device}')\n\n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n        out = output_items[0]\n        for i in range(len(in0)):\n            frame = in0[i]\n            self.b_tensor[0, :] = self.torch.from_numpy(frame.real.astype(np.float32))\n            self.gpu_noise.normal_(mean=0, std=1)\n            with self.torch.no_grad():\n                covert = self.model(self.gpu_noise, self.b_tensor)\n            c_np = covert.cpu().numpy()[0]\n            out[i] = (c_np[0, :] + 1j * c_np[1, :]).astype(np.complex64) * self.gain\n        return len(in0)\n"
    affinity: ''
    alias: ''
    comment: CGAN Covert Generator
    gain_factor: '0.35'
    maxoutbuf: '0'
    minoutbuf: '0'
    model_path: '''generator_lpi.pt'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 304]
    rotation: 0
    state: enabled
- name: blocks_vector_to_stream_0
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
